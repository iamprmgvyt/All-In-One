# ==========================================
# All-In-One (AIO) Discord Bot Framework v3.0
# Author: prmgvyt
# Public Multi-Guild Deployment Environment Configuration
# ==========================================

# Discord Bot Credentials
TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
CLIENT_SECRET=your_discord_client_secret_here

# Default Bot Configuration
PREFIX=!

# Database Connection (MongoDB)
MONGODB=mongodb://localhost:27017/aio_bot

# Security Engine API Keys (Optional)
VIRUSTOTAL_API_KEY=your_virustotal_v3_api_key_here

# Self-Hosted Web Dashboard
DASHBOARD_PORT=3000
