# ==========================================
# All-In-One (AIO) Discord Bot Framework v1.1.0
# Author: prmgvyt
# Public Multi-Guild & Render Free Hosting Environment Config
# ==========================================

# Discord Bot Credentials
TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
CLIENT_SECRET=your_discord_client_secret_here

# Default Bot Configuration
PREFIX=!

# Database Connection (MongoDB Atlas Cloud URL for 24/7 Hosting)
MONGODB=mongodb+srv://user:password@cluster.mongodb.net/aio_bot?retryWrites=true&w=majority

# Security Engine API Keys (Optional Cloud AI Moderation)
GROQ_API_KEY=your_groq_api_key_here
NVIDIA_API_KEY=your_nvidia_ai_nim_key_here
VIRUSTOTAL_API_KEY=your_virustotal_v3_api_key_here

# Render / Free Hosting 24/7 Keep-Alive Self Ping URL
SELF_PING_URL=https://your-render-app-name.onrender.com

# Web Dashboard Port
DASHBOARD_PORT=3000
